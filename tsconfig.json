{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "outDir": "out", "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
