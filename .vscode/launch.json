{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Kawaii Python in isolated VS Code",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.cache/debug/user-data",
        "--extensions-dir=${workspaceFolder}/.cache/debug/extensions"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
